
# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin Gmail (tamaro Gmail)
VITE_ADMIN_EMAIL=you@gmail.com

# AdSense
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_GALLERY=
VITE_ADSENSE_SLOT_PLAYGROUND=
VITE_ADSENSE_SLOT_COURSE=
VITE_ADSENSE_SLOT_WALLPAPER=

# ─────────────────────────────────────────────────────────────
# NEW (Aug 2026): Admin panel -> GitHub animation storage.
# Set these in Vercel dashboard -> Project -> Settings -> Environment
# Variables. Do NOT put real values in this file / do NOT commit them.
# None of these should have the VITE_ prefix — that prefix ships a
# variable's value into the public browser bundle, which must never
# happen to a token or private key.
# ─────────────────────────────────────────────────────────────

# Fine-grained GitHub PAT, scoped to ONLY this repo, "Contents: Read and
# write" permission only. Create at: github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# The repo the Admin panel commits new animations to
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_BRANCH=main

# Firebase service account (Firebase Console -> Project Settings ->
# Service Accounts -> Generate new private key -> open the downloaded
# JSON and copy these 3 fields). Used ONLY to verify the admin's
# sign-in server-side before allowing a GitHub push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The one Google account allowed to publish (usually the same address as
# VITE_ADMIN_EMAIL above, kept separate on purpose so the server-side
# check never depends on a client-exposed variable)
ADMIN_EMAIL=you@gmail.com

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Admin Gmail (tamaro Gmail)
VITE_ADMIN_EMAIL=you@gmail.com

# AdSense
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_HOME=
VITE_ADSENSE_SLOT_GALLERY=
VITE_ADSENSE_SLOT_PLAYGROUND=
VITE_ADSENSE_SLOT_COURSE=
VITE_ADSENSE_SLOT_WALLPAPER=
